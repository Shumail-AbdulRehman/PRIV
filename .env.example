PUBLIC_HOST=161.118.180.138
BACKEND_IMAGE=shumail47891/fyp:backend
FRONTEND_IMAGE=shumail47891/fyp:frontend

DATABASE_URL=postgresql://username:password@db.prisma.io:5432/postgres?sslmode=verify-full

BACKEND_PORT=8080
FRONTEND_PORT=5173

VITE_API_BASE_URL=/api

ACCESS_TOKEN_SECRET=replace_me
REFRESH_TOKEN_SECRET=replace_me
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me
MAX_TASK_REASSIGNMENTS=3

# AI verification (AI_PROVIDER=gemini uses Gemini, AI_PROVIDER=openai uses OpenAI)
AI_PROVIDER=gemini
GEMINI_API_KEY=replace_me
GEMINI_VISION_MODEL=gemini-3.6-flash
OPENAI_API_KEY=replace_me
OPENAI_VISION_MODEL=gpt-4o-mini

# Inventory verification: independent random server signing keys (at least 32 characters)
VERIFICATION_QR_SECRET=
VERIFICATION_SLOT_SECRET=
VERIFICATION_QR_KEY_ID=v1

# Cleanliness only; AI_PROVIDER still owns privacy/coverage. No automatic-pass switch.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLEF_MODEL=clef
CLEF_TIMEOUT_MS=30000
# No default threshold. Candidate for evaluation only, NOT validated.
CLEF_CONFIDENCE_THRESHOLD=
CLEF_THRESHOLD_VERSION=unvalidated-no-threshold
