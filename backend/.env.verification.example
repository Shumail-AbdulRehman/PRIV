# Same DATABASE_URL and Cloudinary account as the backend. Never point isolated
# integration tests at a customer database.
VERIFICATION_QR_SECRET=replace-with-a-random-secret-at-least-32-characters
VERIFICATION_SLOT_SECRET=replace-with-an-independent-random-secret-at-least-32-characters
VERIFICATION_QR_KEY_ID=v1
# Run npm run worker:verification in a separate process; total queue claims are
# bounded to 4 jobs globally and 2 per company. AI stages run with configured credentials; automatic cleanliness passing is disabled.
VERIFICATION_TEST_DATABASE_URL=postgresql://test_user@127.0.0.1:55439/priv_verification_test

VERIFICATION_MIN_NATIVE_VERSION=2.0.0
VERIFICATION_WORKER_HEALTH_FILE=/tmp/hygene-verification-worker.json
# No environment variable bypasses autoPassAllowed(). Held-out evaluation and reviewed
# per-fixture/provider/model/prompt/rubric allowlisting are required before future activation.
