# Same DATABASE_URL and Cloudinary account as the backend. Never point isolated
# integration tests at a customer database.
VERIFICATION_QR_SECRET=replace-with-a-random-secret-at-least-32-characters
VERIFICATION_SLOT_SECRET=replace-with-an-independent-random-secret-at-least-32-characters
VERIFICATION_QR_KEY_ID=v1
# AI runs directly in the backend upload request. No worker or photo queue.
# Cleanliness passing still requires a validated release.
VERIFICATION_TEST_DATABASE_URL=postgresql://test_user@127.0.0.1:55439/priv_verification_test

VERIFICATION_MIN_NATIVE_VERSION=2.0.0
# No boolean switch bypasses evaluation. An independently reviewed release artifact
# qualifies only measured fixtures under the exact model/prompt/threshold/rubric.

# Staff photos use Clef for visible cleanliness and screen recapture. No automatic-pass switch.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLEF_MODEL=clef
CLEF_TIMEOUT_MS=30000
# Provisional privacy/view screening cutoff; never enables automatic cleanliness passing.
CLEF_SCREENING_CONFIDENCE_THRESHOLD=0.9
# No default threshold. Calibrate on development labels; validate on held-out rooms.
CLEF_CONFIDENCE_THRESHOLD=
CLEF_THRESHOLD_VERSION=unvalidated-no-threshold
# Private server-owned release JSON and its SHA-256 from verification:clef-release.
# Leave empty until real held-out pipeline results and independent review qualify.
CLEF_RELEASE_RECORD_PATH=
CLEF_RELEASE_RECORD_SHA256=

# Spatial capture defaults OFF in snapshotted company policy.
# EVALUATE records candidate distances only. Neither this switch nor coordinates enables passing.
# Keep false until consented physical-device evaluation and a separately reviewed pilot.
VERIFICATION_SPATIAL_RECAPTURE_ENABLED=false
