generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}
model Company {
  id                     Int                @id @default(autoincrement())
  name                   String
  isActive               Boolean            @default(true)
  plan                   SubscriptionPlan   @default(STARTER)
  subscriptionStatus     SubscriptionStatus @default(CANCELLED)
  planUpdatedAt          DateTime            @default(now())
  billingCustomerId      String?             @unique
  billingSubscriptionId  String?             @unique
  paddleCustomer         PaddleCustomer?
  paddleSubscriptions    PaddleSubscription[]
  paddleTransactions     PaddleTransaction[]
  managers               Manager[]
  staff                  Staff[]
  locations              Location[]
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
}

model PaddleCustomer {
  id              String               @id
  email           String?
  name            String?
  locale          String?
  status          String
  company         Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId       Int?                 @unique
  subscriptions   PaddleSubscription[]
  transactions    PaddleTransaction[]
  paddleCreatedAt DateTime?
  paddleUpdatedAt DateTime
  lastEventAt     DateTime
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([email])
}

model PaddleSubscription {
  id                        String              @id
  customer                  PaddleCustomer      @relation(fields: [customerId], references: [id])
  customerId                String
  company                   Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId                 Int?
  status                    String
  priceId                   String
  productId                 String
  scheduledChangeAction     String?
  scheduledChangeAt         DateTime?
  currentBillingPeriodStart DateTime?
  currentBillingPeriodEnd   DateTime?
  canceledAt                DateTime?
  pausedAt                  DateTime?
  paddleCreatedAt           DateTime?
  paddleUpdatedAt           DateTime
  lastEventAt               DateTime
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  transactions              PaddleTransaction[]

  @@index([customerId])
  @@index([companyId, status])
}

model PaddleTransaction {
  id              String              @id
  customer        PaddleCustomer?     @relation(fields: [customerId], references: [id])
  customerId      String?
  subscription    PaddleSubscription? @relation(fields: [subscriptionId], references: [id])
  subscriptionId  String?
  company         Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId       Int?
  status          String
  currencyCode    String
  total           String?
  invoiceNumber   String?
  paddleCreatedAt DateTime?
  paddleUpdatedAt DateTime
  lastEventAt     DateTime
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([customerId])
  @@index([subscriptionId])
  @@index([companyId])
}

model PaddleWebhookEvent {
  id           String   @id
  eventType    String
  occurredAt   DateTime
  processedAt  DateTime @default(now())

  @@index([eventType])
  @@index([occurredAt])
}

model Manager {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  password     String
  role         Role     @default(MANAGER)
  isActive     Boolean  @default(true)
  refreshToken String?
  company      Company  @relation(fields: [companyId], references: [id])
  companyId    Int
  assignedLocations ManagerLocation[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Staff {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  phone         String?
  password      String
  role          Role           @default(STAFF)
  isActive      Boolean        @default(true)
  refreshToken  String?
  company       Company        @relation(fields: [companyId], references: [id])
  companyId     Int
  location      Location?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  locationId    Int?
  shiftStart    DateTime?
  shiftEnd      DateTime?
  taskTemplates TaskTemplate[]
  taskInstances TaskInstance[]
  taskAssignments TaskAssignment[]
  attendances   Attendance[]
  completionAttempts TaskCompletionAttempt[]
  areaSubmissions TaskAreaSubmission[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([companyId])
  @@index([locationId])
  @@index([isActive])
}

model Location {
  id            Int            @id @default(autoincrement())
  name          String
  address       String
  isActive      Boolean        @default(true)
  company       Company        @relation(fields: [companyId], references: [id])
  companyId     Int
  staff         Staff[]
  taskTemplates TaskTemplate[]
  taskInstances TaskInstance[]
  attendances   Attendance[]
  managerAssignments ManagerLocation[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  latitude      String
  longitude     String
  radiusMeters  Int            @default(500)
  timezone      String         @default("Asia/Karachi")

  @@index([companyId])
  @@index([isActive])
}

model TaskTemplate {
  id               Int            @id @default(autoincrement())
  title            String
  description      String?
  isActive         Boolean        @default(true)
  staff            Staff?         @relation(fields: [staffId], references: [id], onDelete: SetNull)
  staffId          Int?
  location         Location       @relation(fields: [locationId], references: [id])
  locationId       Int
  shiftStart       DateTime
  shiftEnd         DateTime
  recurringType    RecurringType?
  recurringEndDate DateTime?
  referenceImageUrl String?
  referenceImages  TaskTemplateReferenceImage[]
  instances        TaskInstance[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  effectiveDate    DateTime
  qrToken          String         @unique @default(uuid())

  @@index([locationId])
  @@index([isActive])
  @@index([staffId, isActive])
}

model TaskInstance {
  id             Int           @id @default(autoincrement())
  template       TaskTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateId     Int?
  title          String
  date           DateTime
  lateMinutes    Int?
  shiftStart     DateTime
  shiftEnd       DateTime
  status         TaskStatus    @default(PENDING)
  isLate         Boolean       @default(false)
  startedAt      DateTime?
  completedAt    DateTime?
  proofImageUrls String[]      @default([])
  referenceImageUrl String?
  referenceImages TaskInstanceReferenceImage[]
  areaSubmissions TaskAreaSubmission[]
  staff          Staff?        @relation(fields: [staffId], references: [id], onDelete: SetNull)
  staffId        Int?
  location       Location      @relation(fields: [locationId], references: [id])
  locationId     Int
  assignments    TaskAssignment[]
  completionAttempts TaskCompletionAttempt[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  isActive       Boolean       @default(true)

  @@unique([templateId, date])
  @@index([locationId, isActive, date])
  @@index([locationId, status])
  @@index([staffId, isActive, date])
  @@index([staffId, status])
}

model TaskAssignment {
  id             Int              @id @default(autoincrement())
  taskInstance   TaskInstance     @relation(fields: [taskInstanceId], references: [id], onDelete: Cascade)
  taskInstanceId Int
  staff          Staff            @relation(fields: [staffId], references: [id])
  staffId        Int
  status         AssignmentStatus @default(ASSIGNED)
  reason         String?
  isCurrent      Boolean          @default(true)
  assignedAt     DateTime         @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  failedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([taskInstanceId])
  @@index([taskInstanceId, isCurrent])
  @@index([staffId])
  @@index([staffId, isCurrent])
  @@index([status])
}

model TaskCompletionAttempt {
  id                    Int                      @id @default(autoincrement())
  taskInstance          TaskInstance             @relation(fields: [taskInstanceId], references: [id], onDelete: Cascade)
  taskInstanceId        Int
  staff                 Staff                    @relation(fields: [staffId], references: [id])
  staffId               Int
  imageUrl              String
  locationMatchScore    Int?
  cleanlinessMatchScore Int?
  locationMatchReason   String?
  cleanlinessReason     String?
  rawResponse           Json?
  areaName              String?
  submissionId          String?
  status                CompletionAttemptStatus
  createdAt             DateTime                 @default(now())

  @@index([taskInstanceId])
  @@index([staffId])
}

model TaskAreaSubmission {
  id                  Int                        @id @default(autoincrement())
  taskInstanceId      Int
  referenceImageId    Int
  staffId             Int
  photoUrl            String
  scannedAt           DateTime
  uploadedAt          DateTime?
  status              SubmissionStatus           @default(PENDING)
  similarityScore     Float?
  areaMatchStatus     String?
  areaMatchFlag       Boolean                  @default(false)
  bestReferenceImageId Int?
  colorScore          Float?
  ssimScore           Float?
  featureScore        Float?
  matchThresholdUsed  Float?
  blockThresholdUsed  Float?
  colorWeightUsed     Float?
  ssimWeightUsed      Float?
  featureWeightUsed   Float?
  attempts            Json                     @default("[]")
  createdAt           DateTime                 @default(now())

  taskInstance     TaskInstance               @relation(fields: [taskInstanceId], references: [id], onDelete: Cascade)
  referenceImage   TaskInstanceReferenceImage @relation(fields: [referenceImageId], references: [id], onDelete: Cascade)
  staff            Staff                      @relation(fields: [staffId], references: [id])

  @@unique([taskInstanceId, referenceImageId])
  @@index([taskInstanceId])
  @@index([staffId])
}

model TaskTemplateReferenceImage {
  id         Int          @id @default(autoincrement())
  template   TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId Int
  name       String
  imageUrl   String
  sortOrder  Int          @default(0)
  createdAt  DateTime     @default(now())

  @@index([templateId])
}

model TaskInstanceReferenceImage {
  id             Int          @id @default(autoincrement())
  taskInstance   TaskInstance @relation(fields: [taskInstanceId], references: [id], onDelete: Cascade)
  taskInstanceId Int
  name           String
  imageUrl       String
  sortOrder      Int          @default(0)
  submissions    TaskAreaSubmission[]

  @@index([taskInstanceId])
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  companyId   Int?
  actorType   String
  actorId     Int?
  entityType  String
  entityId    Int
  action      String
  reason      String?
  oldValue    Json?
  newValue    Json?
  createdAt   DateTime @default(now())

  @@index([companyId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Attendance {
  id            Int              @id @default(autoincrement())
  staff         Staff            @relation(fields: [staffId], references: [id])
  staffId       Int
  location      Location         @relation(fields: [locationId], references: [id])
  locationId    Int
  date          DateTime
  checkInTime   DateTime?
  checkOutTime  DateTime?
  expectedStart DateTime
  expectedEnd   DateTime
  status        AttendanceStatus @default(ABSENT)
  isLateCheckIn Boolean          @default(false)
  lateMinutes   Int?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  checkInImage  String?
  checkOutImage String?

  @@unique([staffId, date])
  @@index([locationId, date])
  @@index([staffId])
  @@index([staffId, date, status])
}

model ManagerLocation {
  manager    Manager  @relation(fields: [managerId], references: [id], onDelete: Cascade)
  managerId  Int
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId Int      @unique
  createdAt  DateTime @default(now())

  @@id([managerId, locationId])
  @@index([locationId])
}

enum CompletionAttemptStatus {
  APPROVED
  REJECTED_LOCATION
  REJECTED_CLEANLINESS
  ERROR
}

enum AttendanceStatus {
  ABSENT
  CHECKED_IN
  CHECKED_OUT
  LATE
  MISSED_CHECKOUT
}

enum AssignmentStatus {
  ASSIGNED
  STARTED
  COMPLETED
  MISSED
  FAILED
  REASSIGNED
  CANCELLED
}

enum RecurringType {
  DAILY
  ONCE
}

enum Role {
  ADMIN
  MANAGER
  STAFF
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  NOT_COMPLETED_INTIME
  MISSED
  CANCELLED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED_TIMEOUT
  BLOCKED
  CV_ERROR
}

enum SubscriptionPlan {
  STARTER
  PRO
  ADVANCED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
}

// Transactional outbox: permanent record deletion queues remote media cleanup.
model DeletedMedia {
  id        Int      @id @default(autoincrement())
  url       String   @unique
  createdAt DateTime @default(now())
  attempts  Int      @default(0)
  retryAt   DateTime @default(now())

  @@index([retryAt])
}
