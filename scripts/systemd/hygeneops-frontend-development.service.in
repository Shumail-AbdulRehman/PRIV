[Unit]
Description=HygeneOps V5 local frontend
Requires=hygeneops-backend-development.service
After=hygeneops-backend-development.service

[Service]
Type=simple
WorkingDirectory=@ROOT@/frontend
ExecStart=@NODE@ @ROOT@/frontend/node_modules/vite/bin/vite.js --host 127.0.0.1 --port 5173 --strictPort
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
