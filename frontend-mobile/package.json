{
  "name": "frontend-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --lan",
    "start:local": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:lan": "expo start --web --host lan",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "validate:device-config": "node scripts/validate-device-config.mjs",
    "test": "tsx --test src/api/*.test.ts src/verification/*.test.ts tests/*.test.mjs",
    "build:android": "npm run validate:device-config && expo prebuild --platform android --no-install && expo run:android",
    "build:ios": "expo prebuild --platform ios --no-install && expo run:ios"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-navigation/bottom-tabs": "^7.18.17",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.10",
    "@tanstack/react-query": "^5.100.11",
    "axios": "^1.15.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~54.0.35",
    "expo-application": "~7.0.8",
    "expo-asset": "12.0.13",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-crypto": "~15.0.9",
    "expo-file-system": "~19.0.24",
    "expo-haptics": "~15.0.8",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-location": "~19.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "lucide-react-native": "^1.34.0",
    "nativewind": "4.1.23",
    "onnxruntime-react-native": "1.24.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-preset-expo": "~54.0.11",
    "react-refresh": "^0.14.2",
    "react-test-renderer": "19.1.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  }
}
