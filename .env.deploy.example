POSTGRES_DB=cleanops
POSTGRES_USER=cleanops
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://cleanops:change_me@postgres:5432/cleanops?schema=public

BACKEND_IMAGE=ghcr.io/OWNER/cleanops-backend:latest
FRONTEND_IMAGE=ghcr.io/OWNER/cleanops-frontend:latest
MOBILE_WEB_IMAGE=ghcr.io/OWNER/cleanops-mobile-web:latest

FRONTEND_URL=https://app.example.com
BACKEND_PORT=8080
FRONTEND_PORT=80
MOBILE_WEB_PORT=8081

ACCESS_TOKEN_SECRET=replace_me
REFRESH_TOKEN_SECRET=replace_me
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me
MAX_TASK_REASSIGNMENTS=3

# Inventory verification: independent random server signing keys (at least 32 characters)
VERIFICATION_QR_SECRET=
VERIFICATION_SLOT_SECRET=
VERIFICATION_QR_KEY_ID=v1

# Native inventory workflow. Legacy active tasks retain their frozen v1 contract.
VERIFICATION_MIN_NATIVE_VERSION=2.0.0
# Same evaluated provider configuration for backend and worker. Auto-pass remains disabled.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
